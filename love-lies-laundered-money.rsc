1:["$","main",null,{"className":"detail","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Product\",\"name\":\"Love, Lies & Laundered Money\",\"description\":\"A printable mystery game for one to four adults. Investigate a social-media swindler case using shared evidence in 90–120 minutes.\",\"image\":\"https://firstclasslies.github.io/love-lies-case.png\",\"brand\":{\"@type\":\"Brand\",\"name\":\"First Class Lies\"},\"category\":\"Printable mystery game\",\"offers\":{\"@type\":\"Offer\",\"url\":\"https://www.etsy.com/ca/listing/4569808672/adult-mystery-game-love-lies-laundered?utm_source=first_class_lies_site&utm_medium=organic&utm_campaign=love_lies_page\",\"priceCurrency\":\"CAD\",\"price\":\"29.95\",\"availability\":\"https://schema.org/InStock\",\"itemCondition\":\"https://schema.org/NewCondition\"}}"}}],["$","p",null,{"className":"eyebrow","children":"One to four adult players · 90–120 minutes"}],["$","h1",null,{"children":"Love, Lies & Laundered Money"}],["$","p",null,{"className":"lead","children":"A social-media swindler disappears. The evidence says the story is not over."}],["$","img",null,{"src":"/love-lies-case.png","alt":"Love, Lies and Laundered Money printable mystery game evidence files"}],["$","section",null,{"children":[["$","h2",null,{"children":"A shared mystery for solo or group play"}],["$","p",null,{"children":"Follow a fictional trail of romance deception, identity manipulation and financial misconduct. The case is designed for one to four adults, including solo investigators, using shared evidence packets and staged reveals."}],["$","p",null,{"children":"Each instant digital download contains 38 PDFs and 103 pages, including five staged evidence packets, worksheets, optional hints and a complete solution. No host, acting or physical item is required."}],["$","a",null,{"className":"button","href":"https://www.etsy.com/ca/listing/4569808672/adult-mystery-game-love-lies-laundered?utm_source=first_class_lies_site&utm_medium=organic&utm_campaign=love_lies_page","children":"Shop Love, Lies & Laundered Money on Etsy"}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"How to play"}],["$","p",null,{"children":"Open the Start Here guide after download, use screens or print selected pages, and keep later packets closed until instructed. Work at your own pace and use the optional hints when you need a nudge."}]]}]]}]
