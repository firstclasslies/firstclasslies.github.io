e:T42a,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How many people can play The Trust Fund Affair?","acceptedAnswer":{"@type":"Answer","text":"The Trust Fund Affair is designed for exactly two adult players. Each player begins with private evidence to compare during the investigation."}},{"@type":"Question","name":"Do we need a host or acting?","acceptedAnswer":{"@type":"Answer","text":"No. The case includes a Start Here guide, staged evidence, optional hints and a full solution. No host, acting, props or outside website are required."}},{"@type":"Question","name":"Do we need to print everything?","acceptedAnswer":{"@type":"Answer","text":"No. You can use suitable screens or print selected pages. Each player needs to keep their private evidence separate."}},{"@type":"Question","name":"What is included?","acceptedAnswer":{"@type":"Answer","text":"The digital ZIP includes 33 designed PDFs across 62 pages, separate Player A and Player B evidence, guided worksheets, 10 optional hints and a complete solution."}}]}1:["$","main",null,{"className":"detail","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Product\",\"name\":\"The Trust Fund Affair\",\"description\":\"A two-player printable mystery game for adults. Compare private evidence and solve a fatal fall at a waterfront gala in 75–90 minutes.\",\"image\":\"https://firstclasslies.github.io/trust-fund-case.jpg\",\"brand\":{\"@type\":\"Brand\",\"name\":\"First Class Lies\"},\"category\":\"Printable mystery game\",\"offers\":{\"@type\":\"Offer\",\"url\":\"https://www.etsy.com/ca/listing/4569212128/printable-escape-room-for-adults-the?utm_source=first_class_lies_site&utm_medium=organic&utm_campaign=trust_fund_page\",\"priceCurrency\":\"CAD\",\"price\":\"23.96\",\"priceValidUntil\":\"2026-09-17\",\"availability\":\"https://schema.org/InStock\",\"itemCondition\":\"https://schema.o