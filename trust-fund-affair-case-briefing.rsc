1:["$","main",null,{"className":"briefing","children":[["$","section",null,{"className":"briefing-hero","children":[["$","p",null,{"className":"eyebrow","children":"Spoiler-free case briefing · The Trust Fund Affair"}],["$","h1",null,{"children":"One fall. Two witnesses. A story that does not add up."}],["$","p",null,{"className":"lead","children":"A waterfront gala ends with a fatal fall. The official version is tidy—but the private evidence is not."}],["$","p",null,{"className":"briefing-note","children":"This is a free introduction to the fictional case. It contains no solution and no clues that spoil the full game."}]]}],["$","img",null,{"className":"briefing-image","src":"/trust-fund-case-briefing.png","alt":"Fictional gala mystery case file with sealed dossier, envelope and redacted papers"}],["$","section",null,{"className":"briefing-file","aria-labelledby":"briefing-heading","children":[["$","p",null,{"className":"file-label","children":"CASE FILE · 01"}],["$","h2",null,{"id":"briefing-heading","children":"The opening brief"}],["$","p",null,{"children":"There was a public gala, a private fortune, and just enough time for someone to turn a fall into a cover story. What happened at the waterfront is not something either investigator can untangle alone."}],["$","p",null,{"children":"In the full case, each player receives evidence the other cannot see. Compare details, test your theories and follow the money to discover what really happened."}]]}],["$","section",null,{"className":"briefing-details","children":[["$","div",null,{"children":[["$","p",null,{"className":"eyebrow","children":"Built for two"}],["$","h2",null,{"children":"Play it as a real investigation."}],["$","p",null,{"children":"Two adults. Two private evidence files. One shared fictional mystery."}]]}],["$","div",null,{"className":"briefing-facts","children":[["$","p",null,{"children":[["$","strong",null,{"children":"Format"}],["$","span",null,{"children":"Instant printable or screen-based case"}]]}],["$","p",null,{"children":[["$","strong",null,{"children":"Time"}],["$","span",null,{"children":"75–90 minutes"}]]}],["$","p",null,{"children":[["$","strong",null,{"children":"Setup"}],["$","span",null,{"children":"No host, acting or physical kit required"}]]}]]}]]}],["$","section",null,{"className":"shop-cta","children":[["$","p",null,{"className":"eyebrow","children":"Ready for the full file?"}],["$","h2",null,{"children":"Open the case together."}],["$","a",null,{"className":"button","href":"https://www.etsy.com/ca/listing/4569212128/printable-escape-room-for-adults-the?utm_source=first_class_lies_site&utm_medium=organic_case_briefing&utm_campaign=trust_fund_briefing","children":"Get The Trust Fund Affair on Etsy"}]]}]]}]
